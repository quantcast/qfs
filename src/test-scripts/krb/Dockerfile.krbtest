# Intended to be used for testing QFS Kerberos authentication.
#
# Usage: see krb-test.sh in the same directory.
#
# For example:
# ./krb-test.sh
#

FROM ubuntu:22.04

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install Kerberos and build dependencies
RUN apt-get update && apt-get install -y \
    krb5-kdc \
    krb5-admin-server \
    krb5-user \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# ENV REALM=QFS.TEST
# ENV KDC_HOST=localhost
# ENV ADMIN_PASSWORD=admin123
# ENV TEST_PASSWORD=test123

ENV TEST_DIR=/test
WORKDIR "${TEST_DIR}"

# Setup script
COPY setup_kerberos.sh /setup_kerberos.sh
RUN chmod +x /setup_kerberos.sh

# Run script
COPY <<'RUN_EOF' /run_test.sh
#!/bin/bash
set -e

TEST_DIR=${TEST_DIR:-/test}

exec 0</dev/null
exec 1>"${TEST_DIR}/log"
exec 2>&1

echo "Starting Kerberos services..."
/setup_kerberos.sh

touch "${TEST_DIR}/start"
echo ""
echo "============================================"
echo "Waiting for QFS Kerberos Test to complete..."
echo "============================================"
echo ""
until [ -f "${TEST_DIR}/stop" ]; do
    sleep 0.5
done
RUN_EOF

RUN chmod +x /run_test.sh

CMD ["/run_test.sh"]

